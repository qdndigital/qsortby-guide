---
import Base from '../layouts/Base.astro';
import { loadDocs, groupDocs } from '../lib/docs';
import { site } from '../config';

const infos = await loadDocs();
const groups = groupDocs(infos);
const first = infos[0];
---
<Base>
  <section class="lhero-wrap">
    <div class="lhero wrap">
      <div class="spec"><span class="dot"></span>DOCUMENTATION</div>
      <h1>How can we <span class="it">help</span>?</h1>
      <p>{site.tagline}</p>
      {first && <a class="cta" href={first.url}>Start reading <span>→</span></a>}
    </div>
  </section>

  <section class="wrap lgrid">
    {groups.map((g) => (
      <div class="lcard">
        <div class="lc-h">{g.label}</div>
        <ul>
          {g.items.map((i) => (
            <li><a href={i.url}><span class="lt">{i.entry.data.title}</span>{i.entry.data.description && <span class="ld">{i.entry.data.description}</span>}</a></li>
          ))}
        </ul>
      </div>
    ))}
  </section>
</Base>

<style>
  /* hero — mint aurora + faint dotted grid, matching the QSortby site */
  .lhero-wrap { position:relative; overflow:hidden; }
  .lhero-wrap::before { content:""; position:absolute; inset-inline:0; top:0; height:520px; z-index:-2; pointer-events:none;
    background:
      radial-gradient(48% 46% at 78% -6%, rgba(0,163,107,.13), transparent 70%),
      radial-gradient(40% 42% at 6% 4%, rgba(0,163,107,.07), transparent 72%); }
  .lhero-wrap::after { content:""; position:absolute; inset-inline:0; top:0; height:440px; z-index:-2; opacity:.5; pointer-events:none;
    background-image:radial-gradient(rgba(16,24,40,.06) 1px, transparent 1px); background-size:22px 22px;
    -webkit-mask-image:linear-gradient(180deg,#000 0%,transparent 86%); mask-image:linear-gradient(180deg,#000 0%,transparent 86%); }

  .lhero { padding:72px 20px 40px; max-width:760px; }
  .lhero .spec { display:inline-flex; align-items:center; gap:8px; font-family:'JetBrains Mono',monospace; font-size:11px; letter-spacing:.16em; color:var(--accent-ink);
    background:rgba(255,255,255,.7); border:1px solid #cbe8da; border-radius:999px; padding:6px 12px; backdrop-filter:blur(6px); }
  .lhero .spec .dot { width:6px; height:6px; border-radius:50%; background:var(--accent); }
  .lhero h1 { font-size:clamp(34px,6vw,56px); font-weight:800; letter-spacing:-.045em; line-height:1.02; margin:22px 0 0; }
  .lhero h1 .it { font-family:'Instrument Serif',serif; font-style:italic; font-weight:400; color:var(--accent-ink); }
  .lhero p { font-size:18px; line-height:1.6; color:var(--ink-2); margin:18px 0 0; max-width:52ch; }
  .lhero .cta { display:inline-flex; align-items:center; gap:8px; margin-top:26px; font-weight:600; font-size:15px; background:var(--ink); color:#fff; padding:12px 20px; border-radius:999px; transition:all .2s var(--ease);
    box-shadow:0 1px 2px rgba(16,24,40,.18),0 8px 20px -10px rgba(16,24,40,.4); }
  .lhero .cta:hover { transform:translateY(-1px); box-shadow:0 2px 4px rgba(16,24,40,.2),0 14px 28px -12px rgba(16,24,40,.5); }
  .lhero .cta span { transition:transform .2s var(--ease); }
  .lhero .cta:hover span { transform:translateX(3px); }

  .lgrid { display:grid; grid-template-columns:repeat(auto-fill,minmax(280px,1fr)); gap:18px; padding-bottom:90px; }
  .lcard { background:var(--surface); border:1px solid var(--line); border-radius:14px; padding:22px 24px; transition:all .2s var(--ease); }
  .lcard:hover { border-color:#cbe8da; box-shadow:var(--shadow-float); transform:translateY(-3px); }
  .lc-h { font-family:'JetBrains Mono',monospace; font-size:11px; letter-spacing:.14em; text-transform:uppercase; color:var(--accent-ink); margin-bottom:12px; display:flex; align-items:center; gap:9px; }
  .lc-h::before { content:""; width:16px; height:2px; border-radius:2px; background:var(--accent); }
  .lcard ul { list-style:none; margin:0; padding:0; display:flex; flex-direction:column; }
  .lcard li + li { border-top:1px solid var(--line); }
  .lcard a { display:flex; flex-direction:column; gap:2px; padding:11px 0; transition:.12s; }
  .lcard a:hover .lt { color:var(--accent-ink); }
  .lcard .lt { font-weight:600; font-size:15px; letter-spacing:-.01em; }
  .lcard .ld { font-size:13px; color:var(--muted); line-height:1.45; }
</style>
